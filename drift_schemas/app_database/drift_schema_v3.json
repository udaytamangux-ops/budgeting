      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"recurring_transaction_rules\" (\"id\" TEXT NOT NULL, \"owner_scope\" TEXT NOT NULL, \"type_key\" TEXT NOT NULL, \"amount_minor_units\" INTEGER NOT NULL, \"currency_code\" TEXT NOT NULL, \"category_key\" TEXT NOT NULL, \"payment_method_key\" TEXT NOT NULL, \"merchant\" TEXT NULL, \"note\" TEXT NULL, \"frequency_key\" TEXT NOT NULL, \"recurrence_calendar_key\" TEXT NOT NULL, \"anchor_day\" INTEGER NOT NULL, \"anchor_month\" INTEGER NOT NULL, \"anchor_weekday\" INTEGER NOT NULL, \"first_due_date_ad_utc_micros\" INTEGER NOT NULL, \"next_due_date_ad_utc_micros\" INTEGER NOT NULL, \"status_key\" TEXT NOT NULL, \"created_at_utc_micros\" INTEGER NOT NULL, \"updated_at_utc_micros\" INTEGER NOT NULL, \"paused_at_utc_micros\" INTEGER NULL, \"deleted_at_utc_micros\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
