      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"recurring_transaction_occurrences\" (\"id\" TEXT NOT NULL, \"rule_id\" TEXT NOT NULL, \"owner_scope\" TEXT NOT NULL, \"due_date_ad_utc_micros\" INTEGER NOT NULL, \"status_key\" TEXT NOT NULL, \"type_key\" TEXT NOT NULL, \"amount_minor_units\" INTEGER NOT NULL, \"currency_code\" TEXT NOT NULL, \"category_key\" TEXT NOT NULL, \"payment_method_key\" TEXT NOT NULL, \"merchant\" TEXT NULL, \"note\" TEXT NULL, \"recorded_transaction_id\" TEXT NULL, \"handled_at_utc_micros\" INTEGER NULL, \"created_at_utc_micros\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), UNIQUE (\"owner_scope\", \"rule_id\", \"due_date_ad_utc_micros\"));"
