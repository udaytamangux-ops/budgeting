      "name": "stored_transactions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"stored_transactions\" (\"id\" TEXT NOT NULL, \"type_key\" TEXT NOT NULL, \"amount_minor_units\" INTEGER NOT NULL, \"currency_code\" TEXT NOT NULL, \"category_key\" TEXT NOT NULL, \"payment_method_key\" TEXT NOT NULL, \"occurred_at_utc_micros\" INTEGER NOT NULL, \"merchant\" TEXT NULL, \"note\" TEXT NULL, \"created_at_utc_micros\" INTEGER NOT NULL, \"updated_at_utc_micros\" INTEGER NOT NULL, \"owner_scope\" TEXT NOT NULL DEFAULT 'guest', PRIMARY KEY (\"id\"));"
        }
      ]
    },
